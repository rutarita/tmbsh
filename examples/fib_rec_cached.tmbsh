
cache={}
def fib(n)
    n=$n->num()
    if $n->eq(%0)
        return %0
    elsif $n->eq(%1)
        return %1
    elsif $n->eq(%2)
        return %2
    end
    if a=$cache[$n]?
        return $a
    end
    # first=$n->sub(%1)
    # second=$n->sub(%2)
    answer=$fib($n->sub(%1))->add($fib($n->sub(%2)))
    # answer=$fib($first)->add($second)
    @$cache[$n]=$answer
    return $answer
end

echo $fib(1000)
